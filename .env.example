# Copy this file to .env and fill in your values.
# Never commit .env.

# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/jobradar

# Greenhouse board token (Step 1: stripe)
GREENHOUSE_BOARD_TOKEN=stripe

# Telegram Bot API token  (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat / channel ID to send alerts to
TELEGRAM_CHAT_ID=

# NextAuth / Auth.js (Single-user login)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_USERNAME=

